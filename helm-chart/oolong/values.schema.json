{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "gitPod": {
      "type": "object",
      "properties": {
        "revisionRetentionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          }
        },
        "repoUrl": {
          "type": "string",
          "maxLength": 2048,
          "not": { "pattern": "@" }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["none", "token"] },
            "existingSecret": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
            },
            "token": {
              "type": "object",
              "additionalProperties": false,
              "required": ["usernameKey", "tokenKey"],
              "properties": {
                "usernameKey": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$" },
                "tokenKey": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$" }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "const": "token" } } },
              "then": {
                "required": ["existingSecret", "token"],
                "properties": { "existingSecret": { "minLength": 1 } }
              }
            },
            {
              "if": { "properties": { "type": { "const": "none" } } },
              "then": { "properties": { "existingSecret": { "maxLength": 0 } } }
            }
          ]
        }
      }
    }
  }
}

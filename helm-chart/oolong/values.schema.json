{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "gitPod": {
      "type": "object",
      "properties": {
        "revisionRetentionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          }
        },
        "repoUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["none", "token", "ssh"] },
            "existingSecret": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
            },
            "token": {
              "type": "object",
              "additionalProperties": false,
              "required": ["usernameKey", "tokenKey"],
              "properties": {
                "usernameKey": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$" },
                "tokenKey": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$" }
              }
            },
            "ssh": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "privateKeyKey": { "type": "string", "maxLength": 253, "pattern": "^([-._a-zA-Z0-9]+)?$" },
                "knownHostsKey": { "type": "string", "maxLength": 253, "pattern": "^([-._a-zA-Z0-9]+)?$" },
                "knownHosts": { "type": "string", "maxLength": 65536, "not": { "pattern": "PRIVATE KEY" } }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "const": "token" } } },
              "then": {
                "required": ["existingSecret", "token"],
                "properties": { "existingSecret": { "minLength": 1 } }
              }
            },
            {
              "if": { "properties": { "type": { "const": "ssh" } } },
              "then": {
                "required": ["existingSecret", "ssh"],
                "properties": {
                  "existingSecret": { "minLength": 1 },
                  "ssh": {
                    "required": ["privateKeyKey"],
                    "properties": { "privateKeyKey": { "minLength": 1 } },
                    "oneOf": [
                      {
                        "required": ["knownHostsKey"],
                        "properties": { "knownHostsKey": { "minLength": 1 }, "knownHosts": { "maxLength": 0 } }
                      },
                      {
                        "required": ["knownHosts"],
                        "properties": { "knownHosts": { "minLength": 1 }, "knownHostsKey": { "maxLength": 0 } }
                      }
                    ]
                  }
                }
              }
            },
            {
              "if": { "properties": { "type": { "const": "none" } } },
              "then": { "properties": { "existingSecret": { "maxLength": 0 } } }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["auth"],
            "properties": { "auth": { "required": ["type"], "properties": { "type": { "const": "ssh" } } } }
          },
          "then": {
            "properties": {
              "repoUrl": { "not": { "pattern": "^([A-Za-z][A-Za-z0-9+.-]*://)?[^/@]*:[^/@]*@" } }
            }
          },
          "else": {
            "properties": { "repoUrl": { "not": { "pattern": "@" } } }
          }
        }
      ]
    }
  }
}

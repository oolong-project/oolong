# Server Configuration
PORT=3000

# Server Host URL
# Used in the .well-known/tea discovery endpoint
# This should be the public URL where the TEA API is accessible
SERVER_HOST=http://localhost:3000

# Advertised TEA API version. The server accepts only 1.0.0 or v1.0.0.
# Routes are mounted at /v1.0.0. .well-known/tea stays unversioned.
API_VERSION=v1.0.0

# Filesystem content root. Defaults to ../fixtures/tea-1.0.0 from the server cwd.
# CONTENT_DIR=../fixtures/tea-1.0.0

# Git-synced content. The Helm chart sets all three when gitPod.enabled and persistence.enabled are on.
# CONTENT_GIT_SYNC_ENABLED=true turns on polling CONTENT_DIR for new revisions (60 s by default).
# CONTENT_GIT_SYNC_ENABLED=false
# Polling interval for new revisions, in milliseconds.
# CONTENT_RELOAD_INTERVAL_MS=60000
# CONTENT_AWAIT_GIT_REVISION=true starts without content and waits for the first Git revision
# (/.well-known/tea answers 503 until then) instead of serving CONTENT_DIR as static content.
# CONTENT_AWAIT_GIT_REVISION=false

# HMAC key for opaque pagination tokens. Required unless PAGE_TOKEN_DEV_FALLBACK=true
# and NODE_ENV is not production. Do not set the fallback in deployment configs.
# PAGE_TOKEN_SECRET=
# PAGE_TOKEN_DEV_FALLBACK=true